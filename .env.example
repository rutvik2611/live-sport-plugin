# ─── Server ─────────────────────────────────────────────────
PORT=7000
NODE_ENV=production

# ─── Base URL ────────────────────────────────────────────────
# Set this to your public URL for correct stream link generation
# REQUIRED: This must match your Traefik/Cloudflare domain
ADDON_URL=https://sports.example.com

# ─── Resolver ────────────────────────────────────────────────
# Port for the internal HLS resolver child process
RESOLVER_PORT=3000

# ─── Timezone ────────────────────────────────────────────────
# Used for match time display in the UI
TZ=America/New_York

# ─── Rate Limiting ───────────────────────────────────────────
# Max requests per minute per IP for /catalog and /stream endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ─── Cache ───────────────────────────────────────────────────
# How often matches are refreshed from providers (minutes)
CACHE_TTL_MINUTES=5

# ─── Provider Timeouts ───────────────────────────────────────
# In milliseconds
PROVIDER_TIMEOUT=10000
RESOLVE_TIMEOUT=20000

# ─── SSRF Protection (comma-separated) ───────────────────────
# Only these domains are allowed in the /watch?url= parameter
ALLOWED_EMBED_DOMAINS=embed.st,streamfree.top,cdnlivetv.is,cdnlivetv.tv,ppv.st,watchfooty.st,streamic.st,sportyhunter.xyz,streamsports99.fun,ntv.cx,strims24.pl,wwin.cloud,main.wwin.cloud

# ─── User-Agent ──────────────────────────────────────────────
# Spoofed user-agent for provider scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36

# ─── Render.com Keep-Alive ───────────────────────────────────
# Only needed on Render free tier. Auto-detected if set.
# RENDER_EXTERNAL_URL=https://your-app.onrender.com