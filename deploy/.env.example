# ─── NordVPN Credentials (Manual Setup) ──────────────────────
# Get these from https://my.nordaccount.com → Services → NordVPN → Manual Setup
# NEVER commit real credentials. Keep them in .env (gitignored).
NORDVPN_USER=your_nordvpn_username
NORDVPN_PASS=your_nordvpn_password

# ─── NordVPN Server Region ──────────────────────────────────
# Options: United States, United Kingdom, Germany, Japan, etc.
NORDVPN_REGION=United States

# ─── Gluetun ────────────────────────────────────────────────
# Memory/CPU for the VPN container
GLUETUN_MEM=128m
GLUETUN_CPU=0.25

# ─── AdGuard Home ──────────────────────────────────────────
# DNS sinkhole — listens on port 53 (UDP/TCP)
# If port 53 is taken on the host, change to 5353 below
AGH_MEM=128m
AGH_CPU=0.25
AGH_DNS_PORT=53

# ─── Threadfin ──────────────────────────────────────────────
# Memory/CPU for the IPTV manager
THREADFIN_MEM=128m
THREADFIN_CPU=0.25
THREADFIN_PORT=34400

# ─── Uptime Kuma ────────────────────────────────────────────
# Memory/CPU for monitoring
KUMA_MEM=128m
KUMA_CPU=0.25